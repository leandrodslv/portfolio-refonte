---
interface Props {
  expanded?: boolean
  controls?: string
  fullWidth?: boolean
  embedded?: boolean
  class?: string
}

const {
  expanded = false,
  controls,
  fullWidth = false,
  embedded = false,
  class: classe,
  ...attrs
} = Astro.props

const classes = ['ui-select', classe].filter(Boolean).join(' ')
---

<button
  type="button"
  class={classes}
  aria-haspopup="listbox"
  aria-expanded={expanded ? 'true' : 'false'}
  aria-controls={controls}
  data-full={fullWidth || embedded ? '' : undefined}
  data-embedded={embedded ? '' : undefined}
  {...attrs}
>
  <span class="ui-select__label">
    <slot name="icon" />
    <slot />
  </span>
  <slot name="chevron" />
</button>

<style>
  .ui-select {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    min-height: var(--size-target-min);
    padding: var(--space-3);
    border: var(--border-thick) var(--border-style) var(--border-color);
    background: var(--select-bg);
    color: var(--text);
    font-family: inherit;
    font-size: var(--text-sm);
    line-height: var(--leading-sm);
    font-weight: var(--font-weight-black);
    text-transform: uppercase;
    box-shadow: var(--shadow);
    cursor: pointer;
    transition: all var(--duration-fast) var(--ease-standard);
  }
  .ui-select[data-full] {
    width: 100%;
    justify-content: space-between;
  }
  .ui-select[data-embedded] {
    box-shadow: none;
  }
  .ui-select__label {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }
  .ui-select:hover {
    opacity: var(--opacity-hover);
  }
  .ui-select:active {
    box-shadow: none;
    transform: translateY(var(--border-hairline));
  }
  .ui-select:focus-visible {
    outline: var(--focus-width) solid var(--focus-color);
    outline-offset: var(--focus-offset);
  }
</style>
