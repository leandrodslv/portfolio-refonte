---
interface Props {
  variant?: 'hook' | 'category'
  class?: string
}

const { variant = 'category', class: classe, ...attrs } = Astro.props
const classes = ['ui-badge', `ui-badge--${variant}`, classe].filter(Boolean).join(' ')
---

<span class={classes} {...attrs}>
  <slot />
</span>

<style>
  .ui-badge {
    display: inline-block;
    font-weight: var(--font-weight-bold);
  }
  .ui-badge--hook {
    padding: var(--space-2) var(--space-4);
    border: var(--border-thin) var(--border-style) var(--border-color);
    border-radius: var(--radius-lg);
    background: var(--accent-1);
    color: var(--text);
    font-size: var(--text-sm);
    line-height: var(--leading-sm);
    box-shadow: var(--shadow);
  }
  .ui-badge--category {
    padding: var(--space-1) var(--space-2);
    border-radius: var(--radius-md);
    border-width: var(--tag-border-width);
    border-style: var(--tag-border-style);
    border-color: var(--tag-border-color);
    background: var(--tag-bg);
    color: var(--tag-text);
    opacity: var(--tag-opacity);
    font-size: var(--text-2xs);
    font-weight: var(--tag-font-weight);
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    box-shadow: var(--shadow-soft-sm);
  }

  @media (min-width: 48rem) {
    .ui-badge--hook {
      font-size: var(--text-base);
      line-height: var(--leading-base);
    }
  }
</style>
