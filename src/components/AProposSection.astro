---
import { Image } from 'astro:assets'
import portrait from '../assets/apropos/portrait.webp'
import type { AProposVue } from '../content/sections'
import Badge from './ui/Badge.astro'
import Button from './ui/Button.astro'
import Icone from './Icone.astro'
import Section from './ui/Section.astro'
import SectionTitle from './ui/SectionTitle.astro'

interface Props {
  contenu: AProposVue
}

const { contenu } = Astro.props
const { entete } = contenu
const LARGEUR_PORTRAIT = 640
---

<Section id="about" labelledby="about-titre" tone="card" gutter="narrow">
  <SectionTitle id="about-titre">
    {entete.titre}
    {entete.titreMisEnAvant && <Fragment slot="highlight">{entete.titreMisEnAvant}</Fragment>}
  </SectionTitle>
  <div class="apropos__grille">
    <div class="apropos__colonne">
      <Image
        src={portrait}
        alt={contenu.altPortrait}
        width={LARGEUR_PORTRAIT}
        height={Math.round((LARGEUR_PORTRAIT * portrait.height) / portrait.width)}
        loading="lazy"
        class="apropos__portrait"
      />
      <p class="apropos__localisation">
        <Icone nom="map-pin" taille="md" />
        <span>
          <span class="apropos__libelle">{contenu.libelleLocalisation}</span>
          <span class="apropos__valeur">{contenu.valeurLocalisation}</span>
        </span>
      </p>
    </div>
    <div class="apropos__texte">
      {contenu.badge && <Badge variant="hook">{contenu.badge}</Badge>}
      {contenu.paragraphes.map((paragraphe) => (
        <p class="apropos__paragraphe">{paragraphe}</p>
      ))}
      <Button href="/CV_Leandro_Da_Silva.pdf" download>
        {contenu.libelleCv}
        <Icone nom="send" taille="md" />
      </Button>
    </div>
  </div>
</Section>

<style>
  .apropos__grille {
    display: flex;
    flex-direction: column;
    gap: var(--space-8);
  }
  .apropos__colonne {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
  }
  .apropos__portrait {
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border: var(--border-thick) var(--border-style) var(--border-color);
    border-radius: var(--radius-3xl);
    box-shadow: var(--shadow-lg);
  }
  .apropos__localisation {
    display: flex;
    gap: var(--space-3);
    align-items: center;
    margin: 0;
    padding: var(--space-3);
    border: var(--border-thick) var(--border-style) var(--border-color);
    border-radius: var(--radius-xl);
    background: var(--card-bg);
    box-shadow: var(--shadow);
  }
  .apropos__libelle {
    display: block;
    font-size: var(--text-xs);
    font-weight: var(--font-weight-bold);
    text-transform: uppercase;
    opacity: var(--opacity-muted);
  }
  .apropos__valeur {
    display: block;
    font-size: var(--text-sm);
    font-weight: var(--font-weight-black);
  }
  .apropos__texte {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    align-items: flex-start;
  }
  .apropos__paragraphe {
    margin: 0;
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    font-weight: var(--font-weight-medium);
    opacity: var(--opacity-soft);
  }
  @media (min-width: 48rem) {
    .apropos__grille {
      display: grid;
      grid-template-columns: 1fr 2fr;
      gap: var(--space-12);
      align-items: start;
    }
    .apropos__colonne {
      position: sticky;
      top: var(--space-24);
    }
    .apropos__paragraphe {
      font-size: var(--text-xl);
    }
  }
</style>
