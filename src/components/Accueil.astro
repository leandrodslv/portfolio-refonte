---
import { lireAccueil } from '../content/accueil'
import { lireProjets } from '../content/projets'
import { lireSite } from '../content/site'
import type { Locale } from '../lib/localizedPath'
import Gabarit from './Gabarit.astro'
import Hero from './Hero.astro'
import ProjetsSection from './ProjetsSection.astro'
import Section from './ui/Section.astro'
import SectionTitle from './ui/SectionTitle.astro'

interface Props {
  locale: Locale
}

const { locale } = Astro.props
const { navigation } = await lireSite(locale)
const { hero, projets: entete } = await lireAccueil(locale)
const projets = await lireProjets(locale)
const squelettes = [
  { id: 'journey', titre: navigation.parcours },
  { id: 'skills', titre: navigation.competences },
  { id: 'contact', titre: navigation.contact },
]
---

<Gabarit locale={locale}>
  <Hero locale={locale} hero={hero} />
  <ProjetsSection entete={entete} projets={projets} />
  {squelettes.map((section) => (
    <Section id={section.id} labelledby={`${section.id}-titre`}>
      <SectionTitle id={`${section.id}-titre`}>{section.titre}</SectionTitle>
    </Section>
  ))}
</Gabarit>
