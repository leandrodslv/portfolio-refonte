{
  "name": "portfolio-studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "sanity dev",
    "build": "sanity build",
    "schema:extract": "SANITY_STUDIO_PROJECT_ID=${SANITY_STUDIO_PROJECT_ID:-horsligne} sanity schema extract --path schema.json",
