  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanity": "6.24.0",
    "styled-components": "^6.1.15"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^6.0.3"
  }
}
