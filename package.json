{
  "name": "portfolio-refonte",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint . && npm run lint:css",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test --project=chromium",
    "test:mobile": "playwright test --project=mobile",
    "test:navigateurs": "playwright test --project=webkit --project=firefox --project=edge",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "migrer:contenu": "node scripts/migrer-contenu.mjs",
    "extraire:ancien": "node scripts/extraire-ancien.mjs",
    "test:stories": "vitest run --config vitest.stories.config.ts",
    "lint:css": "stylelint \"src/**/*.{astro,css}\""
  },
  "lint-staged": {
    "*.{ts,tsx,astro,js,mjs}": [
      "eslint --fix"
    ],
    "*.{ts,tsx,astro,js,mjs,css,json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^10.0.1",
    "@lhci/cli": "0.16.1",
    "@playwright/test": "^1.65.1",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-vitest": "^10.6.8",
    "@storybook/preact-vite": "^10.6.8",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser": "^5.1.1",
    "@vitest/browser-playwright": "^5.1.1",
    "@vitest/coverage-v8": "^5.1.1",
    "astro": "^7.4.13",
    "axe-core": "^4.14.1",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.1",
    "postcss": "^8.5.33",
    "postcss-html": "^2.0.1",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sirv": "^3.0.2",
    "sirv-cli": "^3.0.1",
    "storybook": "^10.6.7",
    "stylelint": "^18.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@astrojs/react": "7.1.9",
    "@astrojs/sitemap": "3.7.6",
    "@astrojs/vercel": "11.0.22",
    "@sanity/client": "8.17.0",
    "@tailwindcss/vite": "4.3.5",
    "preact": "11.2.0",
    "preact-render-to-string": "6.8.3",
    "tailwindcss": "4.3.5"
  },
  "overrides": {
    "@vercel/routing-utils": {
      "path-to-regexp": "6.3.0"
    }
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Safari versions",
    "last 2 Firefox versions",
    "last 2 Edge versions"
  ]
}
